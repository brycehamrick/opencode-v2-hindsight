{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "/ABSOLUTE/PATH/TO/opencode-v2-hindsight/dist/index.js",
      "options": {
        "hindsightApiUrl": "http://localhost:8888",
        "bankId": "my-project",
        "dynamicBankId": true,
        "dynamicBankGranularity": ["agent", "gitProject"],
        "autoRecall": true,
        "autoRetain": true,
        "retainMode": "facts",
        "debug": false
      }
    }
  ]
}
