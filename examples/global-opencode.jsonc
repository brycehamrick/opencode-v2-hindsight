{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      // Replace with the absolute path to the built plugin on your machine.
      // Must point to the dist/index.js file produced by `npm run build`.
      "package": "/ABSOLUTE/PATH/TO/opencode-v2-hindsight/dist/index.js",
      "options": {
        "dynamicBankId": true,
        "dynamicBankGranularity": ["agent", "gitProject"],
        "autoRecall": true,
        "autoRetain": true,
        "retainMode": "facts"
      }
    }
  ]
}
